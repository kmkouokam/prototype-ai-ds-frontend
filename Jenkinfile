pipeline {
  agent any

  environment {
    NODE_ENV = "staging"
    S3_BUCKET = 'refonte-jenkins-bucket'
    AWS_REGION = 'us-east-1'
    DIST_DIR = 'dist'
    REPORT_DIR = "reports"
    AWS_CREDENTIALS_ID = 'jenkins-credentials-ci-cd'
  }

  tools {
    nodejs "NodeJS_18" // Use the Node.js tool installed via Jenkins global tool config
  }

  stages {

    stage('Checkout Code') {
      steps {
        git branch: 'staging', url: 'https://github.com/kmkouokam/prototype-ai-ds-frontend.git'
      }
    }

    stage('Install dependencies') {
      steps {
        sh 'npm ci'
      }
    }

    stage('Run ESLint') {
      steps {
        sh 'npm install eslint --save-dev || true'
        sh 'npx eslint . --ext .js,.ts || echo "⚠️ ESLint warnings present."'
      }
    }

    

    stage('Run Tests') {
      steps {
        sh 'npm test || echo "⚠️ Tests failed, but continuing pipeline."'
      }
    }


    stage('Build Project') {
      steps {
        script {
          echo "🔧 Starting build..."
          def result = sh(script: 'npm run build', returnStatus: true)
          if (result != 0) {
            echo "⚠️ Build failed. Creating dummy dist for fallback..."
            sh """
              mkdir -p ${BUILD_DIR}
              echo "<html><body><h1>Dummy Build</h1></body></html>" > ${BUILD_DIR}/index.html
            """
          } else {
            echo "✅ Build succeeded."
          }
        }
      }
    }

     

    stage('Archive Build Artifacts') {
      steps {
        archiveArtifacts artifacts: "${BUILD_DIR}/**", allowEmptyArchive: false
      }
    }

  }


  stage('Run Audit') {
      steps {
        echo '🔍 Running npm audit...'
        sh '''
          mkdir -p $REPORT_DIR
          npm audit --json > $REPORT_DIR/npm-audit-report.json || true
        ''' // Don't fail pipeline on audit warning
      }
    }
   stage('Install NodeJsScan') {
      steps {
        echo '⬇️ Installing NodeJsScan...'
        sh '''
          python3 -m pip install --upgrade pip
          pip install nodejsscan
        '''
      }
    }

   stage('Static Code Analysis') {
      steps {
        echo '🔒 Running NodeJsScan static analysis...'
        sh '''
          nodejsscan -d . -o $REPORT_DIR/nodejsscan-report.html || true
        '''
      }
    }
  }
  



  stage('Upload to S3') {
      steps {
        withAWS(region: "${AWS_REGION}", credentials: "${AWS_CREDENTIALS_ID}") {
          // Upload build artifacts
          s3Upload bucket: "${S3_BUCKET}", path: "builds/\${BUILD_NUMBER}/", workingDir: "${BUILD_DIR}"

           // Upload audit + static analysis reports
          s3Upload bucket: "${S3_BUCKET}", path: "reports/${BUILD_NUMBER}/", workingDir: "${REPORT_DIR}"
      }

  post {
     always {
        echo "📦 Pipeline completed. Build: #${env.BUILD_NUMBER}"
        archiveArtifacts artifacts: "${REPORT_DIR}/**", fingerprint: true
     }
    success {
      echo 'Pipeline completed successfully.'
    }
    failure {
      echo 'Pipeline failed. Check logs.'
    }
  }
}
}
